NEXT_PUBLIC_SUPABASE_URL=https://fifexitmmjnkljgetwwf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_7nwZnozXV377e3o61auGHA_HzEQNBmj

# Server-only secret key (Project Settings → API Keys, "sb_secret_…"). Optional: enables log-in
# with a username and profile photo uploads. Put the real value in .env.local only — never in
# this committed file — and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY (the old service_role JWT). Set one or the other.
SUPABASE_SERVICE_ROLE_KEY=

# One-time codes by email are always on. Turn these on only after the channel is configured
# in Supabase (Twilio / Twilio Verify) and you've received a real code with it (README).
AUTH_SMS_ENABLED=false
AUTH_WHATSAPP_ENABLED=false

SUPABASE_JWKS_URL=https://fifexitmmjnkljgetwwf.supabase.co/auth/v1/.well-known/jwks.json

