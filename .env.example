# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API Keys.
# Both values are public (safe for the browser); Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (starts with sb_publishable_). Not the secret key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER prefix the service-role/secret key with NEXT_PUBLIC_ and never import it from
# client components. Server-only usage (admin jobs, moderation tooling). Unused so far.
# SUPABASE_SERVICE_ROLE_KEY=
